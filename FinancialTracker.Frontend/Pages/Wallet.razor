@page "/wallet"
@using FinancialTracker.Frontend.Models
@using FinancialTracker.Frontend.Services
@inject AuthService AuthService
@inject WalletService WalletService
@inject NavigationManager NavigationManager

<MudContainer>
    <MudItem>
        <MudText Typo="Typo.h4" Class="mt-3 mb-4">Кошелек</MudText>
    </MudItem>
    <MudItem>
        <MudText Typo="Typo.h5">Баланс: @_totalBalance руб.</MudText>
    </MudItem>
    <MudGrid Spacing="2" Class="p-2">
        @foreach (var account in _accounts)
        {
            <MudItem xs="12" md="6" lg="4">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <div class="d-flex align-center justify-space-between mb-3">
                            <MudText Typo="Typo.h6" Style="max-width: 70%;">
                                @account.Name
                            </MudText>
                            <MudText Typo="Typo.h6">
                                @account.CurrentBalance
                            </MudText>
                        </div>
                        <MudText Typo="Typo.caption">
                            Account ID: @account.AccountId
                        </MudText>
                    </MudCardContent>
                    
                    <MudCardActions>
                        <MudSpacer />
                        <MudTooltip Text="Редактировать счет">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                           Color="Color.Primary" 
                                           Size="Size.Small" />
                        </MudTooltip>
                        
                        <MudTooltip Text="Удалить счет">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                           Color="Color.Error" 
                                           Size="Size.Small" />
                        </MudTooltip>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
    <MudText Typo="Typo.caption">User ID: @nameidentifier</MudText>
</MudContainer>

@code {
    private bool _isAuthenticated;
    private decimal _totalBalance = 0;
    private List<Account> _accounts = new List<Account>();
    private string nameidentifier;

    protected override async Task OnInitializedAsync()
    {
        _isAuthenticated = await AuthService.IsAuthenticated();

        if (!_isAuthenticated)
        {
            NavigationManager.NavigateTo("/login");
        }

        nameidentifier = await AuthService.GetNameIdentifier();

        await LoadAccounts();
    }
    
    private async Task LoadAccounts()
    {
        StateHasChanged();

        try
        {
            _accounts = await WalletService.GetAllAccountsAsync(nameidentifier);
            _totalBalance = _accounts.Sum(x => x.CurrentBalance);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading accounts: {ex.Message}");
        }
        finally
        {
            StateHasChanged();
        }
    }

}
