@page "/wallet"
@using FinancialTracker.Frontend.Models
@using FinancialTracker.Frontend.Services
@inject AuthService AuthService
@inject WalletService WalletService
@inject NavigationManager NavigationManager

<MudContainer>
    <MudItem>
        <MudText Typo="Typo.h4" Class="mt-3 mb-4">Кошелек</MudText>
    </MudItem>
    <MudItem>
        <MudText Typo="Typo.h5">Баланс: @_totalBalance руб.</MudText>
    </MudItem>

</MudContainer>

@code {
    private bool _isAuthenticated;
    private double _totalBalance = 0;
    private List<Account> _accounts = new List<Account>();

    protected override async Task OnInitializedAsync()
    {
        _isAuthenticated = await AuthService.IsAuthenticated();

        if (!_isAuthenticated)
        {
            NavigationManager.NavigateTo("/login");
        }

        string jti = await AuthService.GetCurrentJti();

        await LoadAccounts(jti);
    }
    
    private async Task LoadAccounts(string jti)
    {
        StateHasChanged();

        try
        {
            _accounts = await WalletService.GetAllAccountsAsync(jti);
            _totalBalance = _accounts.Sum(x => x.CurrentBalance);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading accounts: {ex.Message}");
        }
        finally
        {
            StateHasChanged();
        }
    }

}
