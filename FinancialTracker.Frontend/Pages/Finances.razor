@page "/finances"
@using FinancialTracker.Frontend.Models
@using FinancialTracker.Frontend.Services
@inject AuthService AuthService
@inject WalletService WalletService
@inject NavigationManager NavigationManager

<MudContainer>
    <MudItem>
        <MudText Typo="Typo.h4">Финансы</MudText>
    </MudItem>
    <MudItem>
        <MudText Typo="Typo.h5">Баланс: @totalBalance руб.</MudText>
    </MudItem>

</MudContainer>

@code {
    private bool isAuthenticated;
    private double totalBalance = 0;
    private List<Account> accounts = new List<Account>();

    protected override async Task OnInitializedAsync()
    {
        isAuthenticated = await AuthService.IsAuthenticated();

        if (!isAuthenticated)
        {
            NavigationManager.NavigateTo("/login");
        }

        string jti = await AuthService.GetCurrentJti();

        await LoadAccounts(jti);
    }
    
    private async Task LoadAccounts(string jti)
    {
        StateHasChanged();

        try
        {
            accounts = await WalletService.GetAllAccountsAsync(jti);
            totalBalance = accounts.Sum(x => x.CurrentBalance);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading accounts: {ex.Message}");
        }
        finally
        {
            StateHasChanged();
        }
    }

}
