@page "/register"
@using FinancialTracker.Frontend.Models
@using FinancialTracker.Frontend.Services
@inject AuthService AuthService
@inject NavigationManager NavigationManager

<div class="m-auto w-25">
    <h3>Регистрация</h3>
    
    <EditForm class="d-flex flex-column gap-1" Model="@RegisterRequest" OnValidSubmit="HandleRegister">
        <DataAnnotationsValidator />


        <div class="form-group">
            <label for="fullname">Имя</label>
            <InputText id="fullname" @bind-Value="RegisterRequest.FullName" class="form-control" />
            <ValidationMessage For="@(() => RegisterRequest.FullName)" />
        </div>
    
        <div class="form-group">
            <label for="email">Email</label>
            <InputText id="email" @bind-Value="RegisterRequest.Email" class="form-control" />
            <ValidationMessage For="@(() => RegisterRequest.Email)" />
        </div>

        <div class="form-group">
            <label for="password">Пароль</label>
            <InputText id="password" type="password" @bind-Value="RegisterRequest.Password" class="form-control" />
            <ValidationMessage For="@(() => RegisterRequest.Password)" />
        </div>

        <div class="form-group">
            <label for="confirmPassword">Подтвердите пароль</label>
            <InputText id="confirmPassword" type="password" @bind-Value="RegisterRequest.ConfirmedPassword" class="form-control" />
            <ValidationMessage For="@(() => RegisterRequest.ConfirmedPassword)" />
        </div>

        <button type="submit" class="btn btn-primary">Зарегистрироваться</button>

        @if (_errorMessage != null)
        {
            <div class="text-danger">
                @_errorMessage
            </div>
        }
    </EditForm>
</div>

@code {
    private RegisterRequest RegisterRequest { get; } = new();
    private string? _errorMessage = string.Empty;
    
    private async Task HandleRegister()
    {
        _errorMessage = null;
        try
        {
            await AuthService.Register(RegisterRequest);
            NavigationManager.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            StateHasChanged();
        }
    }
    
}